{
  "name": "@whiter001/autobrowser",
  "version": "0.1.0",
  "description": "面向 AI agent 的浏览器自动化 CLI：本地 relay + Chrome/Edge 扩展，支持导航、点击/填写、snapshot 引用、网络拦截与 HAR，以及 MCP server",
  "keywords": [
    "browser-automation",
    "chrome-extension",
    "cdp",
    "ai-agent",
    "mcp",
    "scraping",
    "bun"
  ],
  "bin": {
    "autobrowser": "dist/autobrowser.js"
  },
  "files": [
    "dist",
    "chrome",
    "docs",
    "README.md"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whiter001/autobrowser.git"
  },
  "bugs": {
    "url": "https://github.com/whiter001/autobrowser/issues"
  },
  "homepage": "https://github.com/whiter001/autobrowser#readme",
  "scripts": {
    "dev": "bun src/cli.ts server",
    "start": "bun src/cli.ts server",
    "test": "bun test",
    "test:live": "bun run build:chrome && AUTOBROWSER_LIVE=1 bun test test/live-smoke.test.ts",
    "fmt": "oxfmt src/ extension/ scripts/ test/",
    "lint": "oxlint src/ extension/ scripts/ test/",
    "fix": "oxfmt --write src/ extension/ scripts/ test/ && oxlint --fix src/ extension/ scripts/ test/",
    "typecheck": "tsc --noEmit && tsc -p extension/tsconfig.json && tsc -p tsconfig.tools.json",
    "check": "bun run typecheck && oxlint src/ extension/ scripts/ test/ && oxfmt --check src/ extension/ scripts/ test/",
    "build:cli": "bun scripts/build-cli.ts",
    "build:chrome": "bun scripts/build-chrome.ts",
    "build": "bun run build:cli && bun run build:chrome",
    "link:bun": "bun scripts/link-bun.ts",
    "prepublishOnly": "bun run build",
    "release": "npm publish --registry=https://registry.npmjs.org/ --access=public",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.13"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  }
}
